<?xml version="1.0"?>
<robot name="robot_arm">

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="robot_base"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="robot_base">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.00938967" ixy="0" ixz="0" iyy="0.00938967" iyz="0" izz="0.0177127"/>
    </inertial>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_leg_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_leg_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_leg_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_leg_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/motor_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 -0.0415" rpy="0 0 0"/>
      <geometry><box size="0.146 0.146 0.077"/></geometry>
    </collision>

    <collision>
      <origin xyz="0.1132 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.1006 0.04 0.02"/></geometry>
    </collision>

    <collision>
      <origin xyz="-0.1132 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.1006 0.04 0.02"/></geometry>
    </collision>

    <collision>
      <origin xyz="0 0.1132 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.04 0.1006 0.02"/></geometry>
    </collision>

    <collision>
      <origin xyz="0 -0.1132 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.04 0.1006 0.02"/></geometry>
    </collision>
  </link>

  <joint name="joint_base_rotate" type="revolute">
    <parent link="robot_base"/>
    <child link="link_turntable"/>
    <origin xyz="0 0 0.0125" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_turntable">
    <inertial>
      <origin xyz="0 0 0.02475" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000274208" ixy="0" ixz="0" iyy="0.000182508" iyz="0" izz="0.000293367"/>
    </inertial>

    <visual>
      <origin xyz="-0 -0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/arm_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/motor_shoulder_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/motor_shoulder_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.02475" rpy="0 0 0"/>
      <geometry><box size="0.055 0.076 0.0495"/></geometry>
    </collision>
  </link>

  <joint name="joint_shoulder" type="revolute">
    <parent link="link_turntable"/>
    <child link="link_upper_arm"/>
    <origin xyz="0 0 0.0395" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_upper_arm">
    <inertial>
      <origin xyz="0 0 0.124" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00172683" ixy="0" ixz="0" iyy="0.00168333" iyz="0" izz="7.68333e-05"/>
    </inertial>

    <visual>
      <origin xyz="-0 -0 -0.052" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0.052" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/upper_arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0.052" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/elbow_a.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0 -0 -0.052" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/motor_elbow.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.124" rpy="0 0 0"/>
      <geometry><box size="0.02 0.038 0.2"/></geometry>
    </collision>

    <collision>
      <origin xyz="0.0425 0 0.2365" rpy="0 0 0"/>
      <geometry><box size="0.045 0.038 0.025"/></geometry>
    </collision>
  </link>

  <joint name="joint_elbow" type="revolute">
    <parent link="link_upper_arm"/>
    <child link="link_forearm"/>
    <origin xyz="0.03 0 0.2368" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_forearm">
    <inertial>
      <origin xyz="0.2625 -0.0015 0.0042" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000496208" ixy="0" ixz="0" iyy="0.00132254" iyz="0" izz="0.00161042"/>
    </inertial>

    <visual>
      <origin xyz="-0.03 -0 -0.2888" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/elbow_b.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0.03 -0 -0.2888" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0.03 -0 -0.2888" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/motor_wrist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.101 0 0.0052" rpy="0 0 0"/>
      <geometry><box size="0.14 0.016 0.016"/></geometry>
    </collision>

    <collision>
      <origin xyz="0.2625 -0.0015 0.0042" rpy="0 0 0"/>
      <geometry><box size="0.171 0.097 0.05"/></geometry>
    </collision>
  </link>

  <joint name="tip_joint" type="fixed">
    <parent link="link_forearm"/>
    <child link="end_effector"/>
    <origin xyz="0.348 0 0.0042" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint_base_rotate">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_elbow">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/pavan/robot_arm_ws/src/robot_arm_description/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
